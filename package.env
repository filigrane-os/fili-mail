# xbps package of fili-mail (Facteur), read by distro/build-repo.sh in the Filigrane repository. Qt Quick comes with
# Quickshell already; qt6-svg draws the icons, qt6-wayland is the platform plugin, libnotify (notify-send) the desktop
# notifications of the background daemon.
DESC="Facteur, the mail client of Filigrane (Qt Quick, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-svg>=0 qt6-wayland>=0 libnotify>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6 libQt6Quick.so.6"
PKG_LICENSE="MIT"
# Same program under another name: `facteur` in a terminal does what `fili-mail` does
ALIASES="facteur"
